{
  "info": {
    "name": "Opportunity API - Member 4 (Applications & Infra)",
    "description": "Postman Collection for Member 4 - Applications Module endpoints (#19 to #24), Auth Login, and Error Scenarios (400, 401, 403, 404, 409).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "Login as Job Seeker (seeker1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set('seekerToken', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"seeker1@gmail.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login as Employer (employer1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set('employerToken', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employer1@techcorp.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Applications Module Endpoints",
      "item": [
        {
          "name": "#19 POST /jobs/:jobId/applications (Apply for Job)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{seekerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resumeUrl\": \"https://example.com/resumes/john_doe.pdf\",\n  \"coverLetter\": \"I am excited to apply for this backend engineering position.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}", "applications"]
            }
          }
        },
        {
          "name": "#19 (Conflict Demo) POST /jobs/:jobId/applications (Duplicate 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{seekerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resumeUrl\": \"https://example.com/resumes/john_doe.pdf\",\n  \"coverLetter\": \"Applying again to demonstrate duplicate prevention 409.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}", "applications"]
            }
          }
        },
        {
          "name": "#20 GET /applications/me (Get My Applications)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{seekerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/me?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "me"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "#21 GET /jobs/:jobId/applications (Job Owner Employer)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/applications?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}", "applications"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "#22 GET /applications/:id (Get Application Details)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{seekerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}"]
            }
          }
        },
        {
          "name": "#23 PATCH /applications/:id/status (Employer Update Status)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REVIEWING\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "status"]
            }
          }
        },
        {
          "name": "#24 DELETE /applications/:id (Withdraw Application)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{seekerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}"]
            }
          }
        }
      ]
    }
  ]
}
